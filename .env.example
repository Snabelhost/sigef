APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

TELCOSMS_API_KEY=
TELCOSMS_API_URL=https://telcosms.co.ao/send_message
TELCOSMS_VERIFY_SSL=true

CORS_ALLOWED_ORIGINS="${APP_URL}"
LIVEWIRE_TEMP_UPLOAD_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SIGA_API_BASE_URL=https://siga.test:8443
SIGA_API_KEY=
SIGA_API_TOKEN=
SIGA_API_VERIFY_SSL=false
SIGA_API_TIMEOUT=20
SIGA_API_CONNECT_TIMEOUT=5
SIGA_API_RETRIES=2
SIGA_API_CACHE_TTL=900
SIGA_API_STALE_CACHE_TTL=86400
SIGA_API_FAILURE_BACKOFF=60
SIGA_API_PER_PAGE=1000
SIGA_API_MAX_PAGES=10
SIGA_API_STUDENTS_ENDPOINT=/api/v1/students
SIGA_API_PROGRAMS_ENDPOINT=/api/v1/catalog/programs
SIGA_API_INSTITUTION_STUDENTS_ENDPOINT=
SIGA_API_STUDENTS_BY_COURSE_ENDPOINT=
